struct Box<T,> {
    T value;

    routine New(T v) -> (Box<T,> b) {
        b.value = v;
    }

    routine Get -> (T v) {
        v = this.value;
    }
}

autotuner GenericBoxTrailingComma(int x) -> (int result) {
    result = 0;

    start -> run;

    state run {
        Box<
            int,
        > b = Box.New(x);

        result = b.Get();

        terminal;
    }
}
