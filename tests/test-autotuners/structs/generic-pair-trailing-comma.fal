struct Pair<T, U> {
    T first;
    U second;

    routine New(T first, U second) -> (Pair<T, U> p) {
        p.first = first;
        p.second = second;
    }

    routine First -> (T value) {
        value = this.first;
    }

    routine Second -> (U value) {
        value = this.second;
    }
}

autotuner GenericPairTrailingComma(
    int a,
    string b,
) -> (
    int out_a,
    string out_b,
) {

    out_a = 0;
    out_b = "";

    start -> run;

    state run {

        Pair<
            int,
            string,
        > p = Pair.New(a, b);

        out_a = p.First();
        out_b = p.Second();

        terminal;
    }
}
